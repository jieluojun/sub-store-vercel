# 后端私密路径：请替换为足够长的随机字符串
SUB_STORE_FRONTEND_BACKEND_PATH=replace-with-a-long-random-secret

# Cloudflare R2（主存储）
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sub-store

# 可选：默认自动使用 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# 可选：R2 对象前缀，默认 sub-store-data/
# R2_PREFIX=sub-store-data/

# 可选：Gist 备份的 Raw URL，用于 R2 为空时恢复
# SUB_STORE_DATA_URL=https://gist.githubusercontent.com/user/gist-id/raw/backup.json
