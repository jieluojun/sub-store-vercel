# 后端私密路径：请替换为足够长的随机字符串
SUB_STORE_FRONTEND_BACKEND_PATH=replace-with-a-long-random-secret

# 存储提供商：auto（默认）/ r2 / global-config / vercel-blob
# 如果同时配置了 R2 和 Global Config，请明确选择其中一个。
# SUB_STORE_STORAGE_PROVIDER=r2

# ==================== Cloudflare R2（推荐） ====================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sub-store

# 可选：默认自动使用 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# 可选：R2 对象前缀，默认 sub-store-data/
# R2_PREFIX=sub-store-data/

# ==================== Vercel Global Config（可选） ====================
# 使用时取消以下三项注释。GLOBAL_CONFIG 通常在 Store 连接项目后自动注入。
# SUB_STORE_STORAGE_PROVIDER=global-config
# GLOBAL_CONFIG=https://global-config.vercel.com/ecfg_xxx?token=read-token
# GLOBAL_CONFIG_WRITE_TOKEN=your-vercel-api-token

# Team scope 通常会从 Vercel OIDC 自动识别；以下仅用于手动覆盖。
# GLOBAL_CONFIG_TEAM_ID=team_xxx
# GLOBAL_CONFIG_TEAM_SLUG=your-team-slug

# 通常可从 GLOBAL_CONFIG 自动识别；只有识别失败时才填写。
# GLOBAL_CONFIG_ID=ecfg_xxx

# Global Config Item 默认是 sub_store_data 和 sub_store_root。
# GLOBAL_CONFIG_ITEM_PREFIX=sub_store

# ==================== Gist 灾难恢复（可选） ====================
# Gist 备份的 Raw URL，用于共享存储为空时恢复。
# SUB_STORE_DATA_URL=https://gist.githubusercontent.com/user/gist-id/raw/backup.json
