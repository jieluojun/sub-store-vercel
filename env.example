# 后端私密路径：请替换为足够长的随机字符串
SUB_STORE_FRONTEND_BACKEND_PATH=replace-with-a-long-random-secret

# GitHub 私有仓库存储（主推方案）
# GITHUB_REPO_USER : GitHub 用户名（或组织名）
# GITHUB_REPO_TOKEN: Personal Access Token
#                    · classic 勾选 repo 权限 / fine-grained 给该仓库 Contents 读写权限
# GITHUB_REPO_NAME : 仓库名称，纯名称 / owner/repo / 完整 URL 均可
GITHUB_REPO_USER=your-github-username
GITHUB_REPO_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_NAME=sub-store-data

# 可选：存储分支（默认 = 仓库默认分支）
# GITHUB_REPO_BRANCH=main

# 可选：仓库内存储目录前缀，默认 sub-store-data/
# SUB_STORE_STORAGE_PREFIX=sub-store-data/

# ⚠️ 请使用独立的私有数据仓库，不要指向 Vercel 正在部署的代码仓库，
#    否则每次保存数据产生的 commit 都会触发 Vercel 重新部署。

# 可选：Gist 备份的 Raw URL，用于共享存储为空时恢复
# SUB_STORE_DATA_URL=https://gist.githubusercontent.com/user/gist-id/raw/backup.json
