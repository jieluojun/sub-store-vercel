{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{dist.zip,version.json,sub-store.min.js}",
        "maxDuration": 60,
        "memory": 1024
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/server.js" }]
}
